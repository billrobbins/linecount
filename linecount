#!/usr/bin/env python3
"""linecount — count lines in a directory/repo, ls -la style.

Shows each file and directory with its line count. Directories show the
recursive total of everything inside. Inside a git repo it respects
.gitignore (by asking git directly); elsewhere it skips a built-in junk
list. Binary files are never counted as lines.

Examples:
    linecount                  # flat listing of the current directory
    linecount ~/Projects/foo   # flat listing of a specific directory
    linecount --tree           # full nested tree
    linecount --depth 2        # nest N levels deep
    linecount --all            # count everything (ignore .gitignore/junk)
    linecount --name           # sort alphabetically instead of by size
    linecount --self-test      # run the test suite against this script
"""

import argparse
import os
import subprocess
import sys
from fnmatch import fnmatch

# Directories skipped when NOT using git's ignore rules (non-repo or --all-off
# walk). The git path handles ignores itself, so this is only the fallback.
JUNK_DIRS = {
    ".git", ".hg", ".svn", "node_modules", "bower_components", "vendor",
    "dist", "build", "out", ".next", ".nuxt", ".cache", "__pycache__",
    ".venv", "venv", "env", ".idea", ".gradle", ".terraform", "coverage",
    ".pytest_cache", ".mypy_cache", ".tox", ".parcel-cache",
}

# Version-control metadata: never source, so skipped even with --all.
VCS_DIRS = {".git", ".hg", ".svn"}

# Dependency lockfiles: tracked text, but machine-generated noise that drowns
# out real code. Skipped by default; --all brings them back.
LOCKFILES = {
    "package-lock.json", "npm-shrinkwrap.json", "yarn.lock",
    "pnpm-lock.yaml", "bun.lock", "composer.lock", "Gemfile.lock",
    "Cargo.lock", "poetry.lock", "Pipfile.lock", "packages.lock.json",
    "go.sum", "flake.lock",
}

# Extensions treated as binary up front (skip reading them entirely). Anything
# not listed here still gets a NUL-byte sniff before being counted.
BINARY_EXTS = {
    # images
    ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico", ".webp", ".tif",
    ".tiff", ".heic", ".avif", ".psd",
    # fonts
    ".woff", ".woff2", ".ttf", ".otf", ".eot",
    # archives
    ".zip", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar", ".tar", ".jar",
    # media
    ".mp3", ".mp4", ".mov", ".avi", ".mkv", ".webm", ".wav", ".flac",
    ".ogg", ".m4a", ".aac",
    # docs / binaries
    ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
    ".exe", ".dll", ".so", ".dylib", ".o", ".a", ".class", ".pyc",
    ".bin", ".dat", ".db", ".sqlite", ".sqlite3", ".wasm",
}

# Whole filenames treated as binary. Dotfiles like ".DS_Store" have no
# extension as far as os.path.splitext is concerned, so they live here.
BINARY_NAMES = {".ds_store"}


def is_binary(path):
    """True if the file looks binary (skip it)."""
    ext = os.path.splitext(path)[1].lower()
    if ext in BINARY_EXTS or os.path.basename(path).lower() in BINARY_NAMES:
        return True
    try:
        with open(path, "rb") as fh:
            return b"\x00" in fh.read(8192)
    except OSError:
        return True  # unreadable -> treat as skippable


def count_lines(path):
    """Count lines in a file. A final line lacking a trailing newline still
    counts (unlike `wc -l`). Returns None if the file can't be read."""
    try:
        total = 0
        last = b"\n"
        with open(path, "rb") as fh:
            while True:
                chunk = fh.read(1 << 20)
                if not chunk:
                    break
                total += chunk.count(b"\n")
                last = chunk[-1:]
        if last != b"\n":  # non-empty file with no trailing newline
            total += 1
        return total
    except OSError:
        return None


def build_excluder(target, patterns):
    """Return a predicate is_excluded(full_path) for --exclude values.

    A value containing a path separator (or "~") is treated as a PATH and
    excludes that directory/file and everything under it (absolute, or
    relative to the directory being counted). A bare value is treated as a
    NAME/glob and matches any path component, anywhere in the tree
    (e.g. `docs`, `*.min.js`, `__tests__`)."""
    # Allow comma-separated values within a single -x, e.g.
    #   -x ~/proj/docs,~/proj/tests
    entries = [part for raw in patterns for part in raw.split(",") if part]
    if not entries:
        return lambda _full: False

    prefixes = set()
    globs = []
    for raw in entries:
        p = os.path.expanduser(raw)
        if os.sep in p or os.path.isabs(p):
            if os.path.isabs(p):
                prefixes.add(os.path.normpath(p))
            else:
                prefixes.add(os.path.normpath(os.path.join(target, p)))
                prefixes.add(os.path.normpath(os.path.abspath(p)))
        else:
            globs.append(p)

    def is_excluded(full):
        norm = os.path.normpath(full)
        for pre in prefixes:
            if norm == pre or norm.startswith(pre + os.sep):
                return True
        if globs:
            rel = os.path.relpath(norm, target)
            for part in rel.split(os.sep):
                if any(fnmatch(part, g) for g in globs):
                    return True
        return False

    return is_excluded


def collect_git(target):
    """Files under `target` per git's own ignore rules (tracked + untracked,
    minus ignored). Returns a list of relative paths, or None if `target`
    isn't inside a git work tree (or git is unavailable)."""
    try:
        proc = subprocess.run(
            ["git", "ls-files", "--cached", "--others",
             "--exclude-standard", "-z"],
            cwd=target, capture_output=True,
        )
    except (FileNotFoundError, OSError):
        return None
    if proc.returncode != 0:
        return None
    rels = []
    for raw in proc.stdout.split(b"\x00"):
        if not raw:
            continue
        rel = raw.decode("utf-8", "surrogateescape")
        # ls-files lists paths relative to cwd; anything outside `target`
        # (a parent-level file in the same repo) starts with "../" — drop it.
        # Match the separator so real names like "..env" survive.
        if rel == ".." or rel.startswith("../") or os.path.isabs(rel):
            continue
        rels.append(rel)
    return rels


def collect_walk(target, count_all, is_excluded):
    """Files under `target` via a filesystem walk. Prunes JUNK_DIRS (unless
    count_all), VCS_DIRS (always), and any --exclude matches. Does not follow
    symlinked dirs."""
    rels = []
    for root, dirs, files in os.walk(target, followlinks=False):
        kept = []
        for d in dirs:
            if d in VCS_DIRS or (not count_all and d in JUNK_DIRS):
                continue
            if is_excluded(os.path.join(root, d)):
                continue
            kept.append(d)
        dirs[:] = kept
        for name in files:
            full = os.path.join(root, name)
            rels.append(os.path.relpath(full, target))
    return rels


def new_dir(name):
    return {"name": name, "is_dir": True, "lines": 0, "files": 0, "kids": {}}


def build_tree(records):
    """records: list of (relpath, line_count). Returns the aggregated root."""
    root = new_dir("")
    for rel, lines in records:
        parts = rel.split(os.sep)
        node = root
        for part in parts[:-1]:
            node = node["kids"].setdefault(part, new_dir(part))
        leaf = parts[-1]
        node["kids"][leaf] = {
            "name": leaf, "is_dir": False, "lines": lines,
            "files": 1, "kids": {},
        }
    _aggregate(root)
    return root


def _aggregate(node):
    if not node["is_dir"]:
        return node["lines"], node["files"]
    tl = tf = 0
    for kid in node["kids"].values():
        l, f = _aggregate(kid)
        tl += l
        tf += f
    node["lines"], node["files"] = tl, tf
    return tl, tf


def sort_kids(node, by_name):
    kids = list(node["kids"].values())
    if by_name:
        kids.sort(key=lambda k: k["name"].lower())
    else:
        kids.sort(key=lambda k: (-k["lines"], k["name"].lower()))
    return kids


# --- rendering -------------------------------------------------------------

class Theme:
    def __init__(self, color):
        self.dir = (lambda s: f"\033[1;34m{s}\033[0m") if color else (lambda s: s)
        self.dim = (lambda s: f"\033[2m{s}\033[0m") if color else (lambda s: s)


def fmt(n):
    return f"{n:,}"


def label(node):
    return node["name"] + "/" if node["is_dir"] else node["name"]


def render_flat(root, by_name, theme):
    kids = sort_kids(root, by_name)
    rows = [(label(k), k["lines"], k["is_dir"]) for k in kids]
    _print_rows(rows, theme)
    _print_footer(root, theme, len(rows))


def render_tree(root, max_depth, by_name, theme):
    rows = []  # (prefix, name, lines, is_dir)
    rows.append(("", label(root) if root["name"] else ".", root["lines"], True))

    def walk(node, depth, prefix):
        if depth >= max_depth:
            return
        kids = sort_kids(node, by_name)
        for i, kid in enumerate(kids):
            last = i == len(kids) - 1
            branch = "└─ " if last else "├─ "
            rows.append((prefix + branch, label(kid), kid["lines"], kid["is_dir"]))
            if kid["is_dir"]:
                walk(kid, depth + 1, prefix + ("   " if last else "│  "))

    walk(root, 0, "")
    _print_tree_rows(rows, theme)


def _print_rows(rows, theme):
    """Flat rows: (text, num, is_dir)."""
    if not rows:
        print(theme.dim("(no countable files)"))
        return
    left_w = max(len(t) for t, _, _ in rows)
    num_w = max(len(fmt(n)) for _, n, _ in rows)
    for text, num, is_dir in rows:
        name = theme.dir(text) if is_dir else text
        pad = " " * (left_w - len(text))
        print(f"{name}{pad}  {fmt(num):>{num_w}}")


def _print_tree_rows(rows, theme):
    """Tree rows: (prefix, name, num, is_dir)."""
    left_w = max(len(p) + len(n) for p, n, _, _ in rows)
    num_w = max(len(fmt(num)) for _, _, num, _ in rows)
    for prefix, name, num, is_dir in rows:
        shown = theme.dir(name) if is_dir else name
        pad = " " * (left_w - len(prefix) - len(name))
        print(f"{theme.dim(prefix)}{shown}{pad}  {fmt(num):>{num_w}}")


def _print_footer(root, theme, shown):
    total = fmt(root["lines"])
    width = max(len(total) + 8, 24)
    print(theme.dim("─" * width))
    noun = "file" if root["files"] == 1 else "files"
    print(f"{'total':<{width - len(total) - 2}}{total}   "
          f"{theme.dim(f'({root['files']:,} {noun})')}")


# Resolve symlinks so a ~/.local/bin/linecount link still finds the repo.
SCRIPT_PATH = os.path.realpath(__file__)
TESTS_PATH = os.path.join(os.path.dirname(SCRIPT_PATH),
                          "tests", "test_linecount.py")


def self_test():
    """Run the unittest suite against this script; returns its exit code."""
    tests = os.path.expanduser(os.environ.get("LINECOUNT_TESTS", TESTS_PATH))
    if not os.path.isfile(tests):
        print(f"linecount: test suite not found: {tests}", file=sys.stderr)
        return 2
    env = dict(os.environ, LINECOUNT=SCRIPT_PATH)
    return subprocess.run([sys.executable, tests, "-v"], env=env).returncode


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="linecount",
        description="Count lines per file/directory, ls -la style.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=("examples:\n"
                "  linecount                  flat listing of the current dir\n"
                "  linecount path/to/repo     listing of a specific dir\n"
                "  linecount --tree           full nested tree\n"
                "  linecount --depth 2        nest N levels\n"
                "  linecount --all            count everything\n"
                "  linecount --name           sort alphabetically\n"
                "  linecount -x ./docs -x '*.min.js'   skip paths/names\n"
                "  linecount --self-test      run the test suite\n"
                "  linecount help             show this help (same as --help)"))
    parser.add_argument("path", nargs="?", default=".",
                        help="directory (or file) to count; default: current dir")
    parser.add_argument("-t", "--tree", action="store_true",
                        help="show a full nested tree")
    parser.add_argument("-d", "--depth", type=int, metavar="N",
                        help="nest N levels deep (implies a tree view)")
    parser.add_argument("-a", "--all", action="store_true",
                        help="count everything; ignore .gitignore, junk dirs, "
                             "and lockfiles (.git etc. are still skipped)")
    parser.add_argument("-x", "--exclude", action="append", metavar="PATH",
                        default=[],
                        help="path or name/glob to skip; repeatable and "
                             "comma-separated (e.g. -x ./docs,build -x '*.min.js')")
    parser.add_argument("-n", "--name", action="store_true",
                        help="sort alphabetically instead of by line count")
    parser.add_argument("--no-color", action="store_true",
                        help="disable colored output")
    parser.add_argument("--self-test", action="store_true",
                        help="run the test suite against this script "
                             "(tests/test_linecount.py beside it; override "
                             "with $LINECOUNT_TESTS)")

    # Allow a bare `linecount help` as a friendly alias for --help.
    if argv is None:
        argv = sys.argv[1:]
    if argv and argv[0] == "help":
        parser.print_help()
        return 0

    args = parser.parse_args(argv)

    if args.self_test:
        return self_test()

    target = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.exists(target):
        parser.error(f"no such file or directory: {args.path}")

    color = (sys.stdout.isatty() and not args.no_color
             and not os.environ.get("NO_COLOR"))
    theme = Theme(color)

    # A single file: just count it and exit.
    if os.path.isfile(target):
        if is_binary(target):
            print(f"{args.path}: binary file (skipped)")
            return 0
        n = count_lines(target)
        print(f"{os.path.basename(target)}  {fmt(n or 0)}")
        return 0

    is_excluded = build_excluder(target, args.exclude)

    # Gather the file set.
    rels = None
    if not args.all:
        rels = collect_git(target)
    if rels is None:
        rels = collect_walk(target, count_all=args.all, is_excluded=is_excluded)

    records = []
    for rel in rels:
        full = os.path.join(target, rel)
        if not os.path.isfile(full) or is_binary(full):
            continue
        if not args.all and os.path.basename(rel) in LOCKFILES:
            continue
        if is_excluded(full):
            continue
        n = count_lines(full)
        if n is not None:
            records.append((rel, n))

    root = build_tree(records)
    if not records:
        print(theme.dim("(no countable files)"))
        return 0

    if args.depth is not None:
        render_tree(root, max(1, args.depth), args.name, theme)
    elif args.tree:
        render_tree(root, 1 << 30, args.name, theme)
    else:
        render_flat(root, args.name, theme)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
